{
  "name": "polymarket-maker-study",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only public-market-data collector for Polymarket maker-economics research. No auth, no orders, no private keys.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.collector.json",
    "build:all": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.collector.json --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs dist/shared dist/collector",
    "pretest:all": "npm run build:all",
    "test:all": "node scripts/run-tests.mjs dist",
    "collect": "npm run build && node dist/collector/index.js",
    "collect:probe": "npm run build && node dist/collector/index.js --dry-run",
    "analyze": "npm run build:all && node dist/analysis/index.js",
    "start": "node dist/collector/index.js"
  },
  "dependencies": {
    "hyparquet": "^1.31.1",
    "hyparquet-writer": "^0.16.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
